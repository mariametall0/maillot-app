// Schéma de données — application de vente de maillots (V1)
// Voir SPEC.md (section 6) pour le contexte produit.

// Prisma 7 : le générateur "prisma-client" (TS, sans moteur Rust) remplace
// "prisma-client-js" et impose un chemin de sortie explicite. La connexion
// (url/directUrl) n'est plus déclarée ici mais dans prisma.config.ts (voir ce
// fichier) + un adapter passé à PrismaClient (voir src/lib/prisma.ts).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ProductCategory {
  MAILLOT
  EQUIPEMENT
}

// Sous-type utile uniquement pour la catégorie EQUIPEMENT, pour permettre le
// filtrage catalogue (5.1) : "chaussures" / "ballons" / "accessoires" / etc.
enum EquipmentSubtype {
  CHAUSSURES
  BALLONS
  ACCESSOIRES
  AUTRE
}

// Déclinaison de maillot (domicile/extérieur/third) — non utilisé pour les équipements
enum JerseyKit {
  DOMICILE
  EXTERIEUR
  THIRD
}

enum OrderStatus {
  RECUE
  EN_ATTENTE_CONFIRMATION_CLIENT // paiement à la livraison uniquement, avant CONFIRMEE
  CONFIRMEE
  EN_PREPARATION // flocage en cours, si applicable
  EXPEDIEE
  LIVREE
  ANNULEE
}

enum PaymentMethod {
  BANKILY
  MASRVI
  SEDAD
  LIVRAISON
}

enum PaymentStatus {
  EN_ATTENTE
  PAYE
  ECHOUE
}

// ---------------------------------------------------------------------------
// Comptes
// ---------------------------------------------------------------------------

// Client identifié par téléphone (5.7) — pas de mot de passe en V1
model Customer {
  id        String    @id @default(cuid())
  phone     String    @unique
  name      String
  createdAt DateTime  @default(now())
  addresses Address[]
  orders    Order[]
}

// Compte admin unique (5.6) — auth via Supabase Auth, mot de passe géré côté Supabase
model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Adresse de livraison, rattachée au client et réutilisable (5.7)
model Address {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  ville      String
  quartier   String?
  details    String? // repère, indication complémentaire
  createdAt  DateTime @default(now())
  orders     Order[]
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model Product {
  id          String            @id @default(cuid())
  category    ProductCategory
  subtype     EquipmentSubtype? // pertinent uniquement si category = EQUIPEMENT
  club        String? // pertinent uniquement si category = MAILLOT
  season      String? // pertinent uniquement si category = MAILLOT
  name        String
  description String?
  basePrice   Decimal           @db.Decimal(10, 2)
  personalizable Boolean        @default(false) // true uniquement pour les maillots
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  images   ProductImage[]
  variants ProductVariant[]

  @@index([category])
}

// Plusieurs photos par produit (recto/verso/détail floqué), réordonnables (5.1)
model ProductImage {
  id        String     @id @default(cuid())
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String // chemin Supabase Storage
  kit       JerseyKit? // photo spécifique à une déclinaison (domicile/extérieur/third), sinon générique
  position  Int        @default(0)

  @@index([productId])
}

// Stock par taille/pointure/déclinaison — article générique, jamais floqué en stock (5.2)
model ProductVariant {
  id            String    @id @default(cuid())
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId     String
  kit           JerseyKit? // domicile/extérieur/third, uniquement pour les maillots
  sizeLabel     String // valeur affichée : "M", "42", ...
  sizeType      String // "taille" | "pointure", pour l'affichage admin/catalogue
  stock         Int       @default(0)
  priceOverride Decimal?  @db.Decimal(10, 2) // remplace basePrice si renseigné
  createdAt     DateTime  @default(now())

  orderItems OrderItem[]

  @@unique([productId, kit, sizeLabel])
}

// ---------------------------------------------------------------------------
// Commandes
// ---------------------------------------------------------------------------

model Order {
  id            String        @id @default(cuid())
  customer      Customer      @relation(fields: [customerId], references: [id])
  customerId    String
  // Nullable : optionnelle à la commande si paiement à la livraison, renseignée
  // ensuite lors de l'appel de confirmation (5.3 / 5.5)
  address       Address?      @relation(fields: [addressId], references: [id])
  addressId     String?
  status        OrderStatus   @default(RECUE)
  paymentMethod PaymentMethod
  subtotal      Decimal       @db.Decimal(10, 2) // somme des OrderItem (produit + flocage)
  deliveryFee   Decimal       @db.Decimal(10, 2) @default(0)
  total         Decimal       @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items   OrderItem[]
  payment Payment?

  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id        String         @id @default(cuid())
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  variantId String
  quantity  Int            @default(1)

  // Prix éclatés pour permettre les stats admin et un éventuel remboursement partiel
  unitPrice          Decimal @db.Decimal(10, 2) // prix de base au moment de la commande
  personalizationFee Decimal @db.Decimal(10, 2) @default(0)

  // Flocage (5.2) — uniquement si le produit est personnalisable
  personalizationName   String?
  personalizationNumber Int?

  @@index([orderId])
}

model Payment {
  id        String        @id @default(cuid())
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String        @unique
  method    PaymentMethod
  status    PaymentStatus @default(EN_ATTENTE)
  reference String? // référence de transaction (Bankily/Masrvi/Sedad) si applicable
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}
